# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Every setting has a default; only set what you want to change.

# --- LLM provider: anthropic | openai | ollama ---
# anthropic and openai send the retrieved code (and your question) to that service; ollama stays on this machine.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Unset = the model's own default. Only sent when set.
# ANTHROPIC_EFFORT=high
# Re-run on another model when a safety classifier wrongly declines a request (Claude API only).
ANTHROPIC_REFUSAL_FALLBACK=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Context window given to Ollama. Its own default is too small for a retrieved prompt and silently truncates it.
# The retrieval budget shrinks automatically to fit.
OLLAMA_NUM_CTX=16384

# --- Answer generation ---
# Includes the model's thinking on Claude, so keep it generous. Answers cut off at this limit are flagged.
ANSWER_MAX_TOKENS=16000
# Unset = the provider's default. Claude models reject an explicit temperature, so leave it unset for them.
# ANSWER_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120

# --- Embedding provider: local | openai | ollama ---
# local = sentence-transformers on this machine (nothing is sent anywhere).
# openai sends chunk text to OpenAI; ollama needs a running Ollama server.
EMBEDDING_PROVIDER=local
# Chosen by the M1 benchmark: see docs/EMBEDDING_BENCHMARK.md
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Changing the embedding model requires: codebase-ai index REPO --full

# --- Where indexes are stored (default: ~/.codebase_ai) ---
# INDEX_DIR=

# --- Ingestion / chunking ---
MAX_FILE_BYTES=1000000
MAX_CONFIG_BYTES=200000
CHUNK_MAX_LINES=120
WINDOW_LINES=60
WINDOW_OVERLAP=10
EMBED_BATCH_SIZE=64

# --- Retrieval / prompt budget ---
CONTEXT_TOKEN_BUDGET=12000
RETRIEVE_TOP_K=30
# vector | keyword | hybrid. Defaults follow the M2 evaluation (docs/RETRIEVAL_EVAL.md): vector matched or beat hybrid.
RETRIEVAL_MODE=vector
# Only used by hybrid: weight of keyword results relative to vector results (1.0 = equal, 0 = ignore keywords)
KEYWORD_WEIGHT=1.0
# Score multiplier for test files (tests/, *.test.js, test_*.py ...) unless the query is about tests. 1 = off.
TEST_PENALTY=0.5

# --- Reranking ---
# A cross-encoder that re-orders the top candidates (runs on this machine; downloads the model on first use).
# Off unless set. It is only worth turning on if it helps: see docs/QUALITY_EVAL.md.
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=30

# --- Question handling ---
# Questions about the whole repository ("what does this project do?") also get a generated map of it and the README.
USE_REPO_MAP=true
REPO_MAP_TOKENS=1500
# A follow-up ("and what about retries?") is rewritten into a standalone question with one short model call.
CONDENSE_FOLLOWUPS=true
# How many earlier exchanges that rewrite sees. 0 turns follow-up handling off.
HISTORY_TURNS=3
